# CoderXP Production Nginx Configuration with TLS
# Domain: coderxp.pro, www.coderxp.pro, *.preview.coderxp.pro
# ACTIVATE ONLY AFTER TLS CERTIFICATES ARE GENERATED AT /etc/ssl/coderxp/

server {
    listen 80;
    server_name coderxp.pro www.coderxp.pro *.preview.coderxp.pro preview.coderxp.pro;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name coderxp.pro www.coderxp.pro;

    ssl_certificate     /etc/ssl/coderxp/fullchain.pem;
    ssl_certificate_key /etc/ssl/coderxp/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;


    # Devbox PTY WebSocket Upgrade
    location /ws/devbox/ {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }


    # Next.js Web & API Control Plane
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl http2;
    server_name *.preview.coderxp.pro preview.coderxp.pro;

    ssl_certificate     /etc/ssl/coderxp/fullchain.pem;
    ssl_certificate_key /etc/ssl/coderxp/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Live Preview Router (Fail-Closed)
    # Default is static 503 until isolation test passes. Once approved, proxy to 3400.
    location / {
        default_type text/plain;
        return 503 "[CoderXP Live Preview Contained] Live preview is disabled pending pre-cutover isolation verification.\n";
        # proxy_pass http://127.0.0.1:3400;
    }
}
