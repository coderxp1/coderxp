#!/bin/bash
# CoderXP Devbox Git Credential Helper
# Physical Gate Enforcement for T3 Git Operations

ACTION="$1"
if [ "$ACTION" != "get" ]; then
    exit 0
fi

# Read git credential request from stdin
PROTO=""
HOST=""
PATH_URL=""

while IFS='=' read -r key val; do
    [ -z "$key" ] && break
    case "$key" in
        protocol) PROTO="$val" ;;
        host) HOST="$val" ;;
        path) PATH_URL="$val" ;;
    esac
done

# Gate host URL (defaults to Docker gateway IP 172.19.0.1:3100 or host bridge)
GATE_URL="${CODERXP_GATE_URL:-http://172.19.0.1:3100/api/devbox/credentials}"
PROJECT_ID="${CODERXP_PROJECT_ID:-default-project}"

# Detect current branch
CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || echo 'main')"
IS_DEFAULT=false
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ] || [ -z "$CURRENT_BRANCH" ]; then
    IS_DEFAULT=true
fi

# Request credential release from host gate
PAYLOAD=$(jq -n \
    --arg pid "$PROJECT_ID" \
    --arg branch "$CURRENT_BRANCH" \
    --argjson isDef "$IS_DEFAULT" \
    '{
        projectId: $pid,
        actionRequest: {
            type: "git_push",
            branch: $branch,
            isDefaultBranch: $isDef
        }
    }')

RESP=$(curl -s -m 5 -X POST "$GATE_URL" \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD" 2>/dev/null)

ALLOWED=$(echo "$RESP" | jq -r '.allowed // false' 2>/dev/null)
PAT=$(echo "$RESP" | jq -r '.pat // empty' 2>/dev/null)
ERR=$(echo "$RESP" | jq -r '.error // empty' 2>/dev/null)

if [ "$ALLOWED" = "true" ] && [ -n "$PAT" ]; then
    echo "username=x-access-token"
    echo "password=$PAT"
    exit 0
else
    echo "=================================================================" >&2
    echo " [CoderXP Security Gate] T3 Action Gate: Push Withheld" >&2
    if [ -n "$ERR" ]; then
        echo " Reason: $ERR" >&2
    else
        echo " Reason: Default branch push requires approval in Activity Timeline." >&2
    fi
    echo "=================================================================" >&2
    exit 1
fi
