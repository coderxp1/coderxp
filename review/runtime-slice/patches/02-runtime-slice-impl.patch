+    const frame: StreamFrame = { seq: this.nextSeq++, ts: this.now(), stream, data };
+    this.frames.push(frame);
+    this.retainedBytes += Buffer.byteLength(data, "utf8");
+    for (const cb of this.subscribers) {
+      try {
+        cb(frame);
+      } catch {
